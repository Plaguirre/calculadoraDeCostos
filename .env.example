# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5500

# Mongo
MONGODB_URI=mongodb://localhost:27017/calculadoracostos

# JWT secrets (use strong random strings in production)
ACCESS_TOKEN_SECRET=replace_with_long_random_string
REFRESH_TOKEN_SECRET=replace_with_long_random_string

# Catálogo
# URL pública del servidor. Necesaria para que Tienda Nube / Meta puedan
# descargar las imágenes (localhost no es accesible desde internet).
PUBLIC_BASE_URL=http://localhost:3000
CATALOG_CURRENCY=ARS
# Dónde guardar las fotos: disk (carpeta local) o gridfs (dentro de MongoDB,
# para hostings gratis sin disco persistente como Render free)
IMAGE_STORAGE=disk
# Carpeta para IMAGE_STORAGE=disk (por defecto ./uploads)
# UPLOAD_DIR=
# Activar si corre detrás de un proxy (Render, Railway, Nginx…)
# TRUST_PROXY=1
